# Copy this file to .env and adjust before running docker compose.
# .env is gitignored — never commit your real values.

# --- Postgres ---
POSTGRES_USER=intel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=humint_platform

# --- API ---
# Host port the dashboard is reachable on: http://localhost:8080
API_PORT=8080

# How long a login session stays valid without activity. Sessions are opaque
# random tokens stored in Postgres (not signed JWTs), so there's no secret
# key to generate here — revoking access is just deleting the session row,
# which happens automatically on logout or expiry.
SESSION_LIFETIME_HOURS=12

# Set to true once this sits behind HTTPS (a reverse proxy, Tailscale, etc.)
# so the session cookie gets the Secure flag. Defaults to false because a
# LAN-only HTTP deployment needs it off, or the browser will never send the
# cookie back and login will silently appear broken.
SESSION_COOKIE_SECURE=false

# --- File uploads ---
# Where the api/worker containers store uploaded documents/images. This is
# a path *inside the containers*, backed by the `uploads` named volume in
# docker-compose.yml — it does not need to exist on the host.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# --- Backup / restore ---
# Size ceiling for a backup .zip being uploaded to Admin -> Backup & Restore.
# Deliberately separate from (and much larger than) MAX_UPLOAD_MB above: that
# one caps a single attached document, while a legitimate backup contains the
# whole case including every attachment ever uploaded. Raise it if you get a
# "Backup exceeds MAX_RESTORE_MB limit" error restoring a real backup.
MAX_RESTORE_MB=2048

# --- Audit trail ---
# Every change, plus the reads that move data out (attachment downloads, PDF
# exports, backup downloads, AI Assistant queries), is written to the
# audit_log table. That always happens and has no setting.
#
# How long to keep entries. 0 (the default) keeps everything forever, which is
# the right default for an audit trail — set a number of days only if you have
# a policy that requires one. The worker prunes at most once an hour.
AUDIT_RETENTION_DAYS=0

# How long per-call Ollama records are kept (Admin → Model activity). Unlike
# the audit log above, this has a real default: these are diagnostics, they
# accrue a row on every extraction and every assistant question, and a year of
# them buys nothing a month does not. Set to 0 to keep everything.
OLLAMA_USAGE_RETENTION_DAYS=30

# How often the worker checks for records nobody has touched (Admin →
# Retention). One hour is plenty: the thing being measured is months long, and
# nothing happens at all until an admin sets a window and switches the policy
# on. There is a Run now button on that page for when waiting is not the point.
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Feeds
# ---------------------------------------------------------------------------
#
# Feed items are listed on the Feeds page and go no further until somebody
# sends one to Documents. Sending one fetches the linked article so the
# document holds more than the feed's one-paragraph summary.
#
# How long to wait for a publisher's page.
FEED_FETCH_TIMEOUT_SECONDS=20
#
# Sent with the request. Some publishers refuse an empty one.
# FEED_FETCH_USER_AGENT=humint-platform/1.2 (+self-hosted case management)
#
# By default a link that resolves to a private, loopback or link-local address
# is NOT fetched -- a third-party feed should not be able to make this server
# read things on your internal network and hand them back.
#
# Turn it on only if your feeds genuinely live on your own network (an
# intranet bulletin, a station's dispatch page). With it on, any feed you add
# can make this server fetch anything it can reach.
FEED_FETCH_ALLOW_PRIVATE=false
#
# Forwarding a copy to a syslog collector on ANOTHER machine is what makes the
# trail meaningful against someone with access to this one: an admin can edit
# the local table (or restore an old backup over it), but not a copy that has
# already left the box. Off by default because it needs somewhere to send to.
AUDIT_SYSLOG_ENABLED=false
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
# udp is the classic default and never blocks; tcp is more reliable and is
# what most modern collectors prefer.
AUDIT_SYSLOG_PROTOCOL=udp
AUDIT_SYSLOG_FACILITY=local0
AUDIT_SYSLOG_APP_NAME=humint-platform
#
# Set to true ONLY if something in front of this app (a reverse proxy,
# Tailscale, a load balancer) sets X-Forwarded-For. It makes the audit log
# record the header's address instead of the connecting socket's — which is
# right behind a proxy and trivially forgeable without one.
TRUST_PROXY_HEADERS=false

# --- PDF report export ---
# "Export PDF" on a report builds a formatted intel package (see "Exporting a
# report as a PDF" in the README). All three of these are optional.
# Page size: letter (default) or a4.
PDF_PAGE_SIZE=letter
# Printed in the running header and footer of every exported page. This is
# NOT a classification marking and this app has no classification model —
# put your own organisation's wording here if you have any.
#
# Leave PDF_HEADER_LABEL blank (or delete the line) and the header is built
# from INSTANCE_NAME below instead — so renaming the instance in the app also
# renames what its documents say they came from, with no rebuild. Set it here
# and this value wins outright.
PDF_HEADER_LABEL=
PDF_FOOTER_NOTE=Handle according to your own organisation's policy.

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
# All three are just the STARTING values. An admin can change any of them from
# Admin settings → Branding without touching this file or rebuilding, and the
# stored value wins whenever there is one.

# The name in the top bar, the browser tab, the login screen and (unless
# PDF_HEADER_LABEL is set above) the header of every exported PDF.
INSTANCE_NAME=HUMINT Platform

# Optional #rrggbb that overrides the accent of whichever theme is in use. The
# button fill and the label colour on it are derived from this, so the label
# stays readable whatever you pick. Leave blank to use each theme's own accent.
BRAND_ACCENT=

# The theme people see before choosing one of their own:
#   terminal  green on black, monospace — the original look
#   slate     neutral blue-grey, UI sans
#   graphite  charcoal and bronze
#   archive   paper, serif headings
# A default, not a lock: anyone can still pick a different one for themselves.
DEFAULT_PALETTE=terminal

# --- Ollama ---
# Already running Ollama somewhere on your network (another box, a GPU
# machine, whatever)? Point straight at it and skip the bundled container:
#   OLLAMA_BASE_URL=http://192.168.1.50:11434
#
# Don't have one yet? Start the bundled container with:
#   docker compose --profile local-llm up -d
# and leave this as-is. Either way, pull the model once before first use:
#   docker compose exec ollama ollama pull llama3.1:8b   (bundled)
#   ollama pull llama3.1:8b                               (external instance)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180

# Three models, three jobs, no switching between them. Ollama holds more than
# one at a time, so these can all be different and all be in use at once:
#
#   OLLAMA_MODEL          the assistant you talk to, and the one that writes
#                         proposals. Wants to be a good conversationalist.
#   OLLAMA_EXTRACT_MODEL  pulls entities out of uploaded documents. Wants to
#                         be small, fast, and reliable at returning JSON —
#                         nobody reads its prose, and it runs on every upload.
#   OLLAMA_EMBED_MODEL    turns text into vectors for correlation. A different
#                         kind of model entirely; a chat model cannot do it.
#
# A reasonable split on a modest machine:
#   OLLAMA_MODEL=mistral
#   OLLAMA_EXTRACT_MODEL=llama3.2:3b
#   OLLAMA_EMBED_MODEL=nomic-embed-text
#
# Leave OLLAMA_EXTRACT_MODEL blank to use OLLAMA_MODEL for extraction too,
# which is what happened before this setting existed. Pull whatever you name
# here first, same as the others. All three can also be changed at runtime in
# Admin → Ollama Settings without editing this file or rebuilding.
OLLAMA_EXTRACT_MODEL=

# Separate embedding model used for cross-report/entity correlation (see
# "Correlation" in the README). Leave blank to disable correlation entirely
# — extraction still runs regardless. If you set this, pull the model first:
#   docker compose exec ollama ollama pull nomic-embed-text   (bundled)
#   ollama pull nomic-embed-text                               (external)
OLLAMA_EMBED_MODEL=

# Set to false to skip Ollama entirely. Without it, uploaded documents still
# get OCR'd/text-extracted and stored, but nothing gets auto-suggested into
# the entity graph — you'd be building everything by hand. Correlation is
# also unavailable without an embed model regardless of this setting.
OLLAMA_ENABLED=true

# --- Worker polling ---
# How often (seconds) the worker checks for new attachments to OCR/extract
# and new reports/entities to run correlation against.
WORKER_POLL_INTERVAL_SECONDS=20

# --- Correlation ---
# Cosine-similarity threshold (0-1) above which two entities/reports get
# flagged for analyst review as likely duplicates/links. Higher = fewer
# false positives but more missed matches.
CORRELATION_SIMILARITY_THRESHOLD=0.88

# --- Link signals ---
# A pass over records you have already entered, looking for pairs that look
# connected but are not: two people recorded as children of the same person,
# two people sharing a phone number or address, people named together in
# several reports, a shared surname. Each match goes into the review queue
# with the reason it fired. Nothing is ever written to the case graph without
# someone accepting it.
#
# This needs no model at all — it is SQL over your own data, and it works with
# Ollama switched off entirely.
#
# Off by default, deliberately: switching it on for an established case file
# produces a burst of proposals about records entered months ago, and that
# should be a decision rather than a surprise after an update.
#
# This is the FALLBACK, not the only control: Admin -> Link signals switches
# the pass on and off from inside the app, including "on for ten minutes, then
# off by itself", and takes effect within one worker poll cycle with no
# rebuild. What is set here is what applies when no admin override is saved.
LINK_SIGNALS_ENABLED=false

# How often (seconds) the pass runs. It reads the whole case file and the case
# file does not change quickly, so there is nothing to gain from running it
# every poll cycle. 900 = every fifteen minutes.
LINK_SIGNALS_INTERVAL_SECONDS=900

# Stop proposing once this many suggestions are already waiting. A reviewer
# facing four hundred pending suggestions reviews none of them; the pass picks
# up again as the queue is cleared.
LINK_SIGNALS_MAX_PENDING=60

# --- RSS ingestion ---
# How often (seconds) each individual RSS/Atom feed gets re-polled. No
# feeds are added for you — manage them from the Admin page once logged
# in. Independent of Ollama; ingestion runs whether or not an LLM is
# configured. Lower this for something closer to real-time, or raise it
# for a slow-moving/low-volume source.
RSS_POLL_INTERVAL_SECONDS=900

# --- Geocoding (Location entities) ---
# When a Location has an address but no latitude/longitude, the worker
# looks up coordinates automatically and fills them in, along with the
# Maidenhead grid locator computed from them. Entering coordinates by hand
# always wins — this never overwrites lat/lng that's already set. See
# "Address geocoding + Maidenhead grid" in the README for the full picture,
# including how to retry a failed lookup.
#
# Default provider is the free public OpenStreetMap Nominatim API — no
# signup or key needed, but the address text you enter leaves this machine
# over the internet to be resolved. Point NOMINATIM_BASE_URL at a
# self-hosted Nominatim (or compatible) instance on your own network
# instead if that's not acceptable for your use case.
GEOCODE_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires automated clients to identify/provide a
# way to contact the operator: https://operations.osmfoundation.org/policies/nominatim/
# Please replace this with something that actually identifies you/your
# install (e.g. "humint-platform (youremail@example.com)") rather than
# leaving every self-hosted copy of this app looking identical to them.
GEOCODE_USER_AGENT=humint-platform (set GEOCODE_USER_AGENT in .env)
# Minimum seconds between geocoding requests, regardless of how many
# addresses are queued at once (e.g. right after a bulk CSV import) — keeps
# the worker well under the public Nominatim rate limit. Only lower this if
# you've pointed NOMINATIM_BASE_URL at your own instance with its own
# (looser or absent) limits.
GEOCODE_MIN_INTERVAL_SECONDS=1.1
GEOCODE_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# What is here: reverse geocoding a pin drop
# ---------------------------------------------------------------------------
#
# Clicking the map asks two questions. "What is the address here" goes to the
# same Nominatim instance as the settings above. "What businesses are here"
# goes to Overpass, which is a different public service -- it is what turns a
# pin into "Brennan's Hardware, 114 S Boston Ave" rather than just the street.
#
# Both are optional. With either switched off, or unreachable, a pin drop
# still gives you coordinates and a grid square and says what it could not
# reach -- an instance running offline off map packs loses nothing it had.
OVERPASS_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25
#
# How far to look for named places. About a block: far enough to catch the
# unit next door when the pin landed on the wrong half of a building, close
# enough that the list is still about one place.
PLACE_LOOKUP_RADIUS_M=120
#
# Both services are public and shared. This paces the interactive lookups the
# same way GEOCODE_MIN_INTERVAL_SECONDS paces the worker's.
PLACE_LOOKUP_MIN_INTERVAL_SECONDS=1.1

# --- Correlation fan-out ---
# How many matches one newly-embedded record may propose. Everything above the
# similarity threshold used to be flagged, which is quadratic in disguise: 200
# records that resemble each other -- a feed's worth of news items -- can
# produce thousands of pairs and a review queue nobody can work through.
# These arrive sorted by similarity, so a real duplicate is near the top or it
# is not there at all.
CORRELATION_MAX_MATCHES_PER_RECORD=10

# --- Offline maps ---
# The Map view and the debrief place-picker serve tiles from packs an admin
# downloads while online (Admin settings -> Maps). Nothing here needs setting
# for the app to work; these are the knobs for the downloader.
#
# Where pack files are written. Inside the containers this is a Docker volume;
# packs get large, so put it somewhere with room.
MAP_PACK_DIR=/data/map-packs
# Set false to refuse all pack downloads on this deployment -- e.g. on a
# machine that is never supposed to make an outbound connection.
MAP_DOWNLOAD_ENABLED=true
# Tile requests per second, across the whole worker. Tile servers publish
# usage policies and a pack walks one of them systematically; this is the
# knob that keeps you inside them. Raise it only for a server you run.
MAP_TILE_RATE_LIMIT=4
MAP_TILE_TIMEOUT_SECONDS=20
# Several tile operators require a contactable agent string and will serve
# errors to anything anonymous. Put a real contact in here.
MAP_TILE_USER_AGENT=humint-platform offline map packer (set MAP_TILE_USER_AGENT in .env)
# Refuse a single pack larger than this many tiles. Tile counts quadruple per
# zoom level, so this is the guard against a dragged box that quietly means
# three weeks of downloading.
MAP_PACK_MAX_TILES=2000000

# --- Field devices (the companion app) ---
# A field device is a phone or tablet holding a write-only token. It can post
# a field report into the intake queue and nothing else: the token is refused
# by every read endpoint in the app, so a device that walks off leaks whatever
# is still queued on it and nothing from the case file. Tokens are created in
# Admin settings -> Field devices and are shown exactly once.
#
# Nothing here needs setting for the feature to work; these are the limits a
# submission is held to.
#
# How much text one report may carry.
FIELD_MAX_SUBMISSION_CHARS=20000
# Per photo. Phones produce large frames, and the cap is per file, not per
# report, so a genuine set of five photos still gets through.
# Raised from 25 when video arrived: half a minute of 1080p off a Pixel is
# comfortably past the old figure, and an analyst who cannot send the clip
# they just shot stops shooting clips. The app asks the console for this
# number on connecting, so it can refuse an oversized file before spending
# five minutes uploading it.
FIELD_MAX_FILE_MB=150
FIELD_MAX_FILES=10
# All of one submission's media together. This, not the per-file cap, is
# what actually bounds how much disk a stuck device can fill: the rate limit
# multiplied by a large per-file cap is a lot of megabytes a minute.
FIELD_MAX_SUBMISSION_MB=300
# Writes per device per minute. A phone on a bad connection retries; this is
# the guard against a stuck retry loop filling the queue, not a usage budget.
# The liveness ping the app uses to tell you it can reach the server is not
# counted against it.
FIELD_RATE_PER_MINUTE=30
